+        assert db.scalar(
+            select(CreditAllocation.id)
+            .join(Usage, CreditAllocation.usage_id == Usage.id)
+            .where(Usage.user_id == uid, Usage.usage_type == "ADMIN_GRANT", CreditAllocation.mode == "VOICE")
+        )
