{
  "name": "interview-studio-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "format": "prettier --write src tests docs *.json *.ts index.html",
    "test:e2e": "playwright test",
    "test:e2e:mobile": "H5_PREVIEW=1 playwright test",
    "test:e2e:live": "LIVE_API=1 playwright test tests/e2e/live.spec.ts",
    "test:e2e:billing:live": "LIVE_API=1 playwright test tests/e2e/billing-live.spec.ts",
    "test:e2e:production": "PRODUCTION_PREVIEW=1 playwright test tests/e2e/production.spec.ts"
  },
  "dependencies": {
    "@fix-webm-duration/fix": "^1.0.1",
    "@tanstack/react-query": "^5.90.0",
    "ali-oss": "^6.23.0",
    "antd": "^5.27.0",
    "axios": "^1.12.0",
    "echarts": "^6.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "zod": "^4.1.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/ali-oss": "^6.23.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
