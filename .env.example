# Use a same-origin proxy in development and production. Never put server secrets here.
VITE_API_BASE_URL=/api/v1
API_PROXY_TARGET=http://127.0.0.1:8000
# Same-origin OSS uploads (default). The Web server forwards scoped STS requests.
VITE_OSS_UPLOAD_MODE=proxy
# AI question/closing audio also uses a same-origin, read-only signed URL proxy.
VITE_OSS_AUDIO_MODE=proxy
VITE_OSS_AUDIO_HOST=ai-interview-storage.oss-cn-hangzhou.aliyuncs.com
# Accepted images, answer/session recordings and captions use the same read proxy.
VITE_OSS_MEDIA_MODE=proxy
VITE_OSS_MEDIA_HOST=ai-interview-storage.oss-cn-hangzhou.aliyuncs.com
# Resume PDF/DOCX can override the shared accepted-media host and mode.
VITE_OSS_RESUME_MODE=proxy
# Defaults to VITE_OSS_MEDIA_HOST, then VITE_OSS_AUDIO_HOST, when omitted.
VITE_OSS_RESUME_HOST=ai-interview-storage.oss-cn-hangzhou.aliyuncs.com
# Vite dev/preview upstream only; production Nginx uses nginx.conf's fixed host.
OSS_UPLOAD_TARGET=https://ai-interview-storage.oss-cn-hangzhou.aliyuncs.com
# Experience login is controlled by this flag in every build; backend DEV_LOGIN_ENABLED must also be enabled.
VITE_ENABLE_DEV_LOGIN=true
